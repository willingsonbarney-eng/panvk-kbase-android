+/* Diagnostics: dump the raw native handle (fd sizes and every int) so the
+ * vendor's private buffer layout can be decoded offline by comparing the
+ * loader's buffer with a known-linear sibling. Logging only. */
+static void
+vk_anb_dump_handle(const char *tag, const native_handle_t *h)
+{
+   if (!h)
+      return;
+   for (int i = 0; i < h->numFds; i++) {
+      off_t s = -1;
+      if (h->data[i] >= 0) {
+         s = lseek(h->data[i], 0, SEEK_END);
+         lseek(h->data[i], 0, SEEK_SET);
+      }
+      mesa_logi("[PANVK-ANB] %s fd%d size=%lld", tag, i, (long long)s);
+   }
+   const int *ints = &h->data[h->numFds];
+   for (int i = 0; i < h->numInts; i += 8) {
+      char buf[160];
+      int n = 0;
+      for (int j = i; j < i + 8 && j < h->numInts; j++)
+         n += snprintf(buf + n, sizeof(buf) - n, " %08x", (unsigned)ints[j]);
+      mesa_logi("[PANVK-ANB] %s ints[%d..]:%s", tag, i, buf);
+   }
+}
