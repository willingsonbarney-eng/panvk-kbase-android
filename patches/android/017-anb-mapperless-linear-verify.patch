+/* Raw gralloc usage bits (AHARDWAREBUFFER_USAGE_GPU_FRAMEBUFFER and
+ * COMPOSER_OVERLAY), spelled out so older NDK headers cannot break the build. */
+#define VK_ANB_USAGE_GPU_FRAMEBUFFER (1ULL << 9)
+#define VK_ANB_USAGE_COMPOSER_OVERLAY (1ULL << 11)
+/* Same value as GRALLOC1_CONSUMER_USAGE_CPU_READ_OFTEN in hardware/gralloc1.h. */
+#define VK_ANB_GRALLOC1_CPU_READ_OFTEN ((1ULL << 2) | (1ULL << 1))
+
+static pthread_mutex_t vk_anb_lock = PTHREAD_MUTEX_INITIALIZER;
+static int vk_android_mapperless_state; /* 0 unknown, 1 mapper ok, 2 unreachable */
+
+/* On the platform-loader route the vendor gralloc mapper can be unreachable
+ * from the app namespace (see vk_android_probe_linear_ahb). Detect that once
+ * with a small throwaway AHB. Only when the mapper cannot describe it, the
+ * swapchain buffers are requested with CPU read usage so that
+ * vk_android_probe_linear_anb() can verify their layout. Where the mapper
+ * works nothing changes. */
+static bool
+vk_android_mapperless(void)
+{
+   pthread_mutex_lock(&vk_anb_lock);
+   int state = vk_android_mapperless_state;
+   if (state == 0) {
+      state = 1;
+      AHardwareBuffer_Desc d = {
+         .width = 64,
+         .height = 64,
+         .layers = 1,
+         .format = AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM,
+         .usage = VK_ANB_USAGE_GPU_FRAMEBUFFER |
+                  AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE |
+                  AHARDWAREBUFFER_USAGE_CPU_READ_OFTEN,
+      };
+      struct AHardwareBuffer *ahb = NULL;
+      struct u_gralloc *ug = vk_android_get_ugralloc();
+      if (ug && AHardwareBuffer_allocate(&d, &ahb) == 0 && ahb) {
+         AHardwareBuffer_Desc got;
+         AHardwareBuffer_describe(ahb, &got);
+         struct u_gralloc_buffer_handle gh = {
+            .handle = AHardwareBuffer_getNativeHandle(ahb),
+            .pixel_stride = got.stride,
+            .hal_format = got.format,
+         };
+         struct u_gralloc_buffer_basic_info info;
+         if (u_gralloc_get_buffer_basic_info(ug, &gh, &info) != 0)
+            state = 2;
+         AHardwareBuffer_release(ahb);
+      }
+      vk_android_mapperless_state = state;
+      mesa_logi("[PANVK-ANB] mapper probe: %s",
+                state == 2 ? "mapper unreachable, CPU-read swapchain usage on"
+                           : "mapper ok, swapchain usage unchanged");
+   }
+   pthread_mutex_unlock(&vk_anb_lock);
+   return state == 2;
+}
